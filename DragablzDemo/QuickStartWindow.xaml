<Window x:Class="DragablzDemo.QuickStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dragablz="clr-namespace:Dragablz;assembly=Dragablz"
        xmlns:dockablz="clr-namespace:Dragablz.Dockablz;assembly=Dragablz"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Title="Quick Start Window" Height="341" Width="617">
    <Window.Resources>
        <system:String x:Key="Partition">QuickStart</system:String>
    </Window.Resources>
    <dockablz:Layout Partition="{StaticResource Partition}">
        <dragablz:TabablzControl Margin="8" ConsolidateOrphanedItems="True"
                                 ShowDefaultAddButton="True"
ShowDefaultCloseButton="True">
            <dragablz:TabablzControl.InterTabController>
                <dragablz:InterTabController Partition="{StaticResource Partition}" />
            </dragablz:TabablzControl.InterTabController>
            <dragablz:TabablzControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding }"></TextBlock>
                </DataTemplate>
            </dragablz:TabablzControl.ItemTemplate>
            <dragablz:TabablzControl.SelectedItemTemplate>
                <DataTemplate>
                    <TextBlock HorizontalAlignment="Center" FontSize="36"
                               VerticalAlignment="Center" Text="{Binding }"></TextBlock>
                </DataTemplate>
            </dragablz:TabablzControl.SelectedItemTemplate>
            <system:String>Hello World</system:String>
            <system:String>We Have Tearable Tabs!</system:String>
            <system:String>Tab No. 3</system:String>
            <system:String>I feel like an ice cold drink</system:String>
        </dragablz:TabablzControl>
    </dockablz:Layout>
</Window>